From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dynamic Devices <engineering@dynamicdevices.co.uk>
Date: Thu, 17 Sep 2026 09:00:00 +0100
Subject: [PATCH] Only query the DRI driver directory for X11 Ozone

The i.MX Wayland kiosk uses the Vivante EGL/GBM stack, which does not
install Mesa's dri.pc. Avoid querying the desktop X11 DRI driver
directory when the X11 Ozone platform is disabled.

Upstream-Status: Inappropriate [i.MX Wayland-only product configuration]

---
 content/gpu/BUILD.gn       | 2 +-
 media/gpu/sandbox/BUILD.gn | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/content/gpu/BUILD.gn b/content/gpu/BUILD.gn
index 8a00000..8a00001 100644
--- a/content/gpu/BUILD.gn
+++ b/content/gpu/BUILD.gn
@@ -125,6 +125,6 @@ target(link_target_type, "gpu_sources") {
   # Use DRI on desktop Linux builds.
   if (current_cpu != "s390x" && current_cpu != "ppc64" && is_linux &&
-      !is_castos) {
+      !is_castos && ozone_platform_x11) {
     configs += [ "//build/config/linux/dri" ]
   }
 }

diff --git a/media/gpu/sandbox/BUILD.gn b/media/gpu/sandbox/BUILD.gn
index 8b00000..8b00001 100644
--- a/media/gpu/sandbox/BUILD.gn
+++ b/media/gpu/sandbox/BUILD.gn
@@ -26,6 +26,6 @@ source_set("sandbox") {
   }
   if (current_cpu != "s390x" && current_cpu != "ppc64" && is_linux &&
-      !is_castos) {
+      !is_castos && ozone_platform_x11) {
     # For DRI_DRIVER_DIR.
     configs += [ "//build/config/linux/dri" ]
   }
