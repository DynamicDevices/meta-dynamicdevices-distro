#!/bin/sh
set -eu

# A browser error page does not retry itself after the network returns.
# NetworkManager runs this hook on link or connectivity recovery.
case "${2:-}" in
    up)
        systemctl --no-block try-restart dd-kiosk-browser.service
        ;;
    connectivity-change)
        # NetworkManager 1.46 exports uppercase state names. Accept the
        # lowercase form used by older releases as well.
        case "${CONNECTIVITY_STATE:-}" in
            FULL|full) systemctl --no-block try-restart dd-kiosk-browser.service ;;
        esac
        ;;
esac
