# Persistent startup page. Edit /etc/default/dd-kiosk-browser on the device,
# then run: sudo systemctl restart dd-kiosk-browser.service
# Keep this as a normal YouTube watch page, not player fullscreen.
# autoplay=1&mute=1 requests silent autoplay without weakening browser policy.
# YouTube requires playlist=<video-id> with loop=1 to repeat a single video.
DD_KIOSK_URL=https://www.youtube.com/watch?v=nfWlot6h_JM&autoplay=1&mute=1&loop=1&playlist=nfWlot6h_JM
DD_KIOSK_MUTE_AUDIO=1
# The recipe enables this only for Jaguar Screen's Etnaviv/GC600 runtime.
DD_KIOSK_GLES2_COMPAT=0
