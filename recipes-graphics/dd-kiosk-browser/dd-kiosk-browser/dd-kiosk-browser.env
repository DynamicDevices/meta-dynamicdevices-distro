# Jaguar Screen kiosk product destination. This remains an /etc/default
# conffile so a managed deployment can deliberately override it.
DD_KIOSK_URL=https://active-esl.com
# Set to 1 when this board must start silently, including after a reboot.
# This adds Chromium --mute-audio without changing speaker gain or ALSA state.
DD_KIOSK_MUTE_AUDIO=0
