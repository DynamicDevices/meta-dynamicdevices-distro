# Persistent startup page. Edit /etc/default/dd-kiosk-browser on the device,
# then run: sudo systemctl restart dd-kiosk-browser.service
# Generic product defaults. The recipe substitutes Jaguar Screen's approved
# silent YouTube autoplay/loop URL only for imx8mm-jaguar-screen.
DD_KIOSK_URL=https://active-esl.com
DD_KIOSK_MUTE_AUDIO=0
# The recipe enables this only for Jaguar Screen's Etnaviv/GC600 runtime.
DD_KIOSK_GLES2_COMPAT=0
