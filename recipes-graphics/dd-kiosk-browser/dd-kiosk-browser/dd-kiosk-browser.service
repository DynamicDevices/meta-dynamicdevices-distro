[Unit]
Description=Dynamic Devices Chromium kiosk
After=weston.service systemd-user-sessions.service
Wants=weston.service
Conflicts=screen-aero-demo.service screen-flutter-demo.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=weston
Group=weston
SupplementaryGroups=render video
StateDirectory=dd-kiosk-browser
EnvironmentFile=-/etc/default/dd-kiosk-browser
ExecStart=/usr/bin/dd-kiosk-browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
